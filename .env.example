# Server-side secret for @ipago/sdk. Shown once in the merchant panel.
IPAGO_SECRET_KEY=sk_test_replace_me

# Signing secret for the webhook endpoint you verify (whsec_...).
IPAGO_WEBHOOK_SECRET=whsec_replace_me

# Optional. Read token for a private ipago/platform repo, used only by
# `pnpm generate:sdk <release>`. Leave unset for a public platform repo.
PLATFORM_READ_TOKEN=replace_me
